# ═══════════════════════════════════════════════════════════════════
# Evolora Frontend — Environment Variables (.env.local)
# ═══════════════════════════════════════════════════════════════════

# Public URL to the backend API (must include /api/v1)
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# In production (Vercel), replace with your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api/v1
