# ═══════════════════════════════════════════════════════════════════════════════
# Evolora API — Environment Variables
# Copy this file to .env and fill in your values
# NEVER put real secrets in this template file — it is committed to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# App
APP_NAME=Evolora API
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=evolora

# Auth / JWT — CHANGE THIS IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider — Anthropic Claude via the OpenAI-compatible endpoint
# (Server-side only — NEVER expose the key to the client.)
# Confirm the current model IDs on Anthropic's models/pricing page before deploy.
# ─────────────────────────────────────────────────────────────────────────────
AI_API_KEY=your-anthropic-api-key
AI_BASE_URL=https://api.anthropic.com/v1/
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192

# Per-task model selection: cheap for extraction, stronger for generation,
# strongest for evaluation (the product's IP). VERIFY exact model IDs.
AI_MODEL_EXTRACTION=claude-haiku-4-5
AI_MODEL_GENERATION=claude-sonnet-4-5
AI_MODEL_EVALUATION=claude-sonnet-4-5
AI_MODEL_DEFAULT=claude-sonnet-4-5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LLM_CALLS_PER_USER_PER_DAY=50
